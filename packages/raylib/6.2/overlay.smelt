project "raylib" {
  version = "6.2";
  c_std = 99;
}

dependency "x11" {
  find = pkg_config("x11");
}

dependency "gl" {
  find = pkg_config("gl");
}

target "raylib" {
  type = static_lib;
  export = true;
  warnings = "none";
  source_dir = "src";
  files = ["rcore.c", "rshapes.c", "rtextures.c", "rtext.c", "rmodels.c", "raudio.c", "rglfw.c"];
  public_includes = ["src"];
  defines = ["_GNU_SOURCE", "_GLFW_X11", "PLATFORM_DESKTOP_GLFW", "GRAPHICS_API_OPENGL_33"];
  compile_options = ["-fno-strict-aliasing"];
  link = ["-lm", "-lpthread", "-ldl", "-lrt"];
  depends = ["x11", "gl"];
}
